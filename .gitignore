# Data - tracked by DVC instead of Git
/data/raw/PetImages
/data/processed

# DVC will still track the small .dvc pointer files - keep those
!*.dvc

# MLflow local tracking store (each teammate/CI run generates its own)
mlruns/
mlartifacts/
mlflow.db

# Model artifacts: the final trained baseline model (models/model.pt) is
# intentionally COMMITTED to git, not ignored - the M3 CI pipeline's Docker
# build step needs it present in the checked-out repo, and SimpleCNN is
# tiny (~0.1MB) so this is cheap. If you retrain and want to keep some
# experimental checkpoint out of git, name it something other than
# model.pt/model.pth and it'll stay ignored below.
models/*.pth
models/*.h5
models/*.pkl
!models/.gitkeep
!models/model.pt

# M5: runtime-generated logs and performance monitoring reports - these
# are regenerated every run, not something to version.
logs/
monitoring/reports/

# Misc pipeline scratch space - classification_report.txt is the one
# exception: dvc.yaml declares it as a cache:false pipeline metric, meaning
# DVC expects it to be tracked via git directly, not ignored.
artifacts_tmp/*
!artifacts_tmp/classification_report.txt

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
env/
*.egg-info/
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
